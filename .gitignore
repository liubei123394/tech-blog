wx.config.json
.wx-sync.json
wx-html/

# 编辑器与系统
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
.temp/
.tmp/
